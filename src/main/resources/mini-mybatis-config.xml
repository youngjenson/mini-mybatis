<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <settings>
        <setting name="cacheEnabled" value="true"/>
        <setting name="localCacheScope" value="SESSION"/>
    </settings>
    <plugins>
        <plugin interceptor="cn.jens.mybatis.plugin.SlowSqlInterceptor">
            <property name="thresholdMillis" value="200"/>
        </plugin>
    </plugins>
    <dataSource>
        <property
                name="driver"
                value="com.mysql.cj.jdbc.Driver"/>
        <property
                name="url"
                value="jdbc:mysql://127.0.0.1:3306/test"/>
        <property
                name="username"
                value="root"/>
        <property
                name="password"
                value="root"/>

    </dataSource>
    <mappers>
        <mapper class="cn.jens.demo.mapper.UserMapper"/>
        <mapper resource="cn/jens/demo/mapper/UserXmlMapper.xml"/>
    </mappers>
</configuration>
